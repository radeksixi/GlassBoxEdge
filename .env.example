# edge_node.py reads these from the process environment and does not load .env itself.
# Copy to .env, fill in, then export before running, e.g.:  set -a; . ./.env; set +a

# Per-device key: HMAC signing of telemetry frames and validation of inbound commands.
# On the Jetsons this comes from Key Vault; JET-A and JET-B each have their own.
# Unset, edge_node.py falls back to "dev-key-change-me" (offline demos only).
EDGE_DEVICE_KEY=

# IoT Hub device identity (X.509 or SAS) — required only with --iothub.
IOTHUB_DEVICE_CONNSTR=
